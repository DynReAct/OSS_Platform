# Copy to /etc/dynreact/agents-oss.env and replace example hostnames/URLs.
DYNREACT_PROFILE=oss
LOCAL_REGISTRY=192.168.110.176:5000/
IMAGE_NAME=dynreact-oss-shortterm
IMAGE_TAG_TEMPLATE={revision}
KAFKA_IP=192.168.110.173:9092
REST_URL=http://oss-service.example:8050
KAFKA_TOPIC_PREFIX=Dynreact_OSS
TOPIC_GEN=Dynreact-OSS-Gen
TOPIC_CALLBACK=Dynreact-OSS-Callback
CONTAINER_NAME_PREFIX=dynreact-oss
DOCKER_NETWORK=host
OSS_DOCKER_WORKERS=ssh://oss@worker-a.example,ssh://oss@worker-b.example
DYNREACT_SSH_DIR=/etc/dynreact/ssh-oss
DYNREACT_HOST_LOG_DIR=/var/log/dynreact/oss
DYNREACT_WORKER_LOG_DIR=/home/oss/dynreact-logs
DYNREACT_WORKER_LIMIT=0
# Optional limits: size from measured workload before enabling.
# DYNREACT_REPLICA_MEMORY=512m
# DYNREACT_REPLICA_CPUS=1
# Additional application variables (PERF_URL, SNAPSHOT_VERSION, etc.) go here.
REGISTRY_URL=http://192.168.110.176:5000
REGISTRY_PROTECTED_TAGS=latest,stable,production
