# Copy to /etc/dynreact/agents-ras.env and replace example hostnames/URLs.
DYNREACT_PROFILE=ras
LOCAL_REGISTRY=192.168.110.176:5000/
IMAGE_NAME=dynreact-ras-shortterm
IMAGE_TAG_TEMPLATE={revision}
KAFKA_IP=192.168.110.173:9092
REST_URL=http://ras-service.example:8050
KAFKA_TOPIC_PREFIX=Dynreact_RAS
TOPIC_GEN=Dynreact-RAS-Gen
TOPIC_CALLBACK=Dynreact-RAS-Callback
CONTAINER_NAME_PREFIX=dynreact-ras
DOCKER_NETWORK=host
RAS_DOCKER_WORKERS=ssh://ras@worker-a.example,ssh://ras@worker-b.example
DYNREACT_SSH_DIR=/etc/dynreact/ssh-ras
DYNREACT_HOST_LOG_DIR=/var/log/dynreact/ras
DYNREACT_WORKER_LOG_DIR=/home/ras/dynreact-logs
DYNREACT_WORKER_LIMIT=0
# Optional limits: size from measured workload before enabling.
# DYNREACT_REPLICA_MEMORY=512m
# DYNREACT_REPLICA_CPUS=1
# Additional application variables (PERF_URL, SNAPSHOT_VERSION, etc.) go here.
REGISTRY_URL=http://192.168.110.176:5000
REGISTRY_PROTECTED_TAGS=latest,stable,production
